# Replace dashboard.example.com and the certificate paths with the actual host.
# Issue the certificate with a dedicated HTTP webroot before enabling this file.
server {
    listen 80;
    listen [::]:80;
    server_name dashboard.example.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/polymarket-acme;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dashboard.example.com;
    ssl_certificate /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128k;
    access_log /var/log/nginx/polymarket-access.log;
    error_log /var/log/nginx/polymarket-error.log;
    location / {
        proxy_pass http://127.0.0.1:4105;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
