{
  "name": "polymarket-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --env-file=.env apps/api/src/index.ts",
    "dev:worker": "tsx watch --env-file=.env apps/worker/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "owner:create": "tsx --env-file=.env scripts/create-owner.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "pnpm typecheck && pnpm build:bundle",
    "build:bundle": "vite build --config apps/web/vite.config.ts && tsup apps/api/src/index.ts apps/worker/src/index.ts --format esm --platform node --target node24 --out-dir dist/server --splitting --sourcemap --external pg-native",
    "start:api": "node --env-file=.env dist/server/api/src/index.js",
    "start:worker": "node --env-file=.env dist/server/worker/src/index.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/open-responses": "2.0.58",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@hookform/resolvers": "^5.9.1",
    "@polymarket/client": "0.12.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.5",
    "@tavily/core": "0.7.13",
    "ai": "7.0.127",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^1.51.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "undici": "^8.11.2",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2"
  }
}
